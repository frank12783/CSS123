    private void updateHeaderDisplays() {
        balanceLabel.setText(String.format("Credits: $%.2f", balance));
        mpsLabel.setText(String.format("MPS: $%.2f / sec", calculateTotalMPS()));

        // Update Victory Goal Bar
        double percent = Math.min(100.0, (balance / VICTORY_GOAL) * 100.0);
        goalLabel.setText(String.format("Goal ($1B): %.2f%%", percent));
        goalProgressBar.setValue((int) percent);

        // Check Victory Condition
        if (balance >= VICTORY_GOAL && !victoryAchieved) {
            victoryAchieved = true;
            AudioPlayer.playSound("sounds/victory.wav");
            JOptionPane.showMessageDialog(this, 
                "🎉 CONGRATULATIONS COMMANDER! 🎉\nYou have reached ONE BILLION CREDITS ($1,000,000,000)!", 
                "VICTORY ACHIEVED", JOptionPane.INFORMATION_MESSAGE);
        }
    }

