    private void refreshEquippedGrid() {
        equippedGridPanel.removeAll();
        for (int i = 0; i < 10; i++) {
            final int slotIndex = i;
            Gun gun = equippedGuns[i];
            JPanel slot = new JPanel(new BorderLayout());
            slot.setBackground(new Color(43, 45, 66));

            if (gun != null) {
                slot.setBorder(BorderFactory.createLineBorder(gun.getRarityColor(), 2));
                slot.setCursor(new Cursor(Cursor.HAND_CURSOR));

                JLabel nameLbl = new JLabel(gun.name, SwingConstants.CENTER);
                nameLbl.setFont(new Font("SansSerif", Font.BOLD, 12));
                nameLbl.setForeground(gun.getRarityColor());

                JLabel iconLbl = new JLabel(SpriteLoader.getSprite(gun.spriteFileName, 55, 55, gun.name, gun.getRarityColor()));
                iconLbl.setHorizontalAlignment(SwingConstants.CENTER);

                JLabel mpsLbl = new JLabel(String.format("+%.1f/s (Ref %d)", gun.getEffectiveMps(), gun.duplicates), SwingConstants.CENTER);
                mpsLbl.setFont(new Font("SansSerif", Font.PLAIN, 10));
                mpsLbl.setForeground(Color.LIGHT_GRAY);

                slot.add(nameLbl, BorderLayout.NORTH);
                slot.add(iconLbl, BorderLayout.CENTER);
                slot.add(mpsLbl, BorderLayout.SOUTH);

                slot.addMouseListener(new MouseAdapter() {
                    @Override
                    public void mouseClicked(MouseEvent e) {
                        inventory.add(equippedGuns[slotIndex]);
                        equippedGuns[slotIndex] = null;
                        refreshEquippedGrid();
                        refreshInventoryUI();
                        updateHeaderDisplays();
                    }
                });
            } else {
                slot.setBorder(BorderFactory.createDashedBorder(Color.GRAY));
                JLabel emptyLbl = new JLabel("EMPTY SLOT", SwingConstants.CENTER);
                emptyLbl.setForeground(Color.DARK_GRAY);
                slot.add(emptyLbl, BorderLayout.CENTER);
            }
            equippedGridPanel.add(slot);
        }
        equippedGridPanel.revalidate();
        equippedGridPanel.repaint();
    }

    private void refreshInventoryUI() {
        inventoryPanel.removeAll();
        for (int i = 0; i < inventory.size(); i++) {
            final int invIndex = i;
            Gun gun = inventory.get(invIndex);

            JPanel card = new JPanel(new BorderLayout(5, 5));
            card.setPreferredSize(new Dimension(90, 110));
            card.setBackground(new Color(24, 26, 31));
            card.setBorder(BorderFactory.createLineBorder(gun.getRarityColor(), 1));
            card.setCursor(new Cursor(Cursor.HAND_CURSOR));

            JLabel nameLbl = new JLabel(gun.name, SwingConstants.CENTER);
            nameLbl.setForeground(Color.WHITE);
            nameLbl.setFont(new Font("SansSerif", Font.BOLD, 11));

            JLabel iconLbl = new JLabel(SpriteLoader.getSprite(gun.spriteFileName, 50, 50, gun.name, gun.getRarityColor()));
            iconLbl.setHorizontalAlignment(SwingConstants.CENTER);

            JLabel dupeLbl = new JLabel("Dupes: " + gun.duplicates, SwingConstants.CENTER);
            dupeLbl.setFont(new Font("SansSerif", Font.PLAIN, 10));
            dupeLbl.setForeground(Color.LIGHT_GRAY);

            card.add(nameLbl, BorderLayout.NORTH);
            card.add(iconLbl, BorderLayout.CENTER);
            card.add(dupeLbl, BorderLayout.SOUTH);

            card.addMouseListener(new MouseAdapter() {
                @Override
                public void mouseClicked(MouseEvent e) {
                    int freeSlot = -1;
                    for (int s = 0; s < equippedGuns.length; s++) {
                        if (equippedGuns[s] == null) {
                            freeSlot = s;
                            break;
                        }
                    }

                    if (freeSlot != -1) {
                        equippedGuns[freeSlot] = inventory.remove(invIndex);
                        refreshEquippedGrid();
                        refreshInventoryUI();
                        updateHeaderDisplays();
                    } else {
                        JOptionPane.showMessageDialog(GFL2ClickerApp.this, "All 10 slots full! Click an equipped gun to unequip it first.", "Loadout Full", JOptionPane.INFORMATION_MESSAGE);
                    }
                }
            });

            inventoryPanel.add(card);
        }
        inventoryPanel.revalidate();
        inventoryPanel.repaint();
    }

    // ==========================================
    // 5. GAME LOOP TIMER
    // ==========================================
    private void startGameLoop() {
        Timer timer = new Timer(100, e -> {
            double mps = calculateTotalMPS();
            balance += (mps / 10.0);
            updateHeaderDisplays();
            if (clickerTargetPanel != null) {
                clickerTargetPanel.repaint(); // Animate ambient muzzle flares
            }
        });
        timer.start();
    }

    // ==========================================
    // 6. CUSTOM INTERACTIVE CLICK TARGET PANEL
    // ==========================================
    private class ClickerTargetPanel extends JPanel {
        private double scaleFactor = 1.0;
        private boolean showMuzzleFlare = false;
        private Timer animationTimer;

        public ClickerTargetPanel() {
            setOpaque(false);
            setCursor(new Cursor(Cursor.HAND_CURSOR));

            addMouseListener(new MouseAdapter() {
                @Override
                public void mousePressed(MouseEvent e) {
                    balance += moneyPerClick;
                    updateHeaderDisplays();

                    /* AUDIO HOOK: Cookie Tap Sound Effect */
                    AudioPlayer.playSound("sounds/cookie_tap.wav");

                    // Trigger scale bounce & muzzle flares
                    scaleFactor = 0.88;
                    showMuzzleFlare = true;
                    repaint();

                    if (animationTimer != null && animationTimer.isRunning()) animationTimer.stop();
                    animationTimer = new Timer(50, evt -> {
                        scaleFactor = 1.0;
                        showMuzzleFlare = false;
                        repaint();
                    });
                    animationTimer.setRepeats(false);
                    animationTimer.start();
                }
            });
        }

        @Override
        protected void paintComponent(Graphics g) {
            super.paintComponent(g);
            Graphics2D g2 = (Graphics2D) g.create();
            g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);

            int centerX = getWidth() / 2;
            int centerY = getHeight() / 2;

            // Draw Central Cookie / Terminal Sprite
            int baseSize = 180;
            int drawSize = (int) (baseSize * scaleFactor);
            int targetX = centerX - drawSize / 2;
            int targetY = centerY - drawSize / 2;

            /* IMAGE HOOK: Cookie / Central Click Target Sprite */
            ImageIcon cookieIcon = SpriteLoader.getSprite("cookie-clicker.gif", drawSize, drawSize, "TAP CREDITS", new Color(255, 183, 3));
            cookieIcon.paintIcon(this, g2, targetX, targetY);

            // Draw Equipped Guns Surrounding the Target in a Circle
            int orbitRadius = 180;
            for (int i = 0; i < equippedGuns.length; i++) {
                Gun gun = equippedGuns[i];
                if (gun == null) continue;

                double angle = (2 * Math.PI / 10) * i;
                int gx = (int) (centerX + orbitRadius * Math.cos(angle)) - 25;
                int gy = (int) (centerY + orbitRadius * Math.sin(angle)) - 25;

                // Render Gun Sprite
                ImageIcon gunIcon = SpriteLoader.getSprite(gun.spriteFileName, 50, 50, gun.name, gun.getRarityColor());
                gunIcon.paintIcon(this, g2, gx, gy);

                // Draw Muzzle Flare Effect when firing/clicking
                if (showMuzzleFlare || random.nextDouble() < 0.15) { // Flash when clicked or randomly auto-firing
                    int flareX = (int) (gx + 15 * Math.cos(angle));
                    int flareY = (int) (gy + 15 * Math.sin(angle));

                    /* IMAGE HOOK: Muzzle Flare PNG Overlay */
                    ImageIcon flareIcon = SpriteLoader.getSprite("muzzle_flare.png", 35, 35, "*FLASH*", Color.YELLOW);
                    flareIcon.paintIcon(this, g2, flareX, flareY);
                }
            }

            g2.dispose();
        }
    }

    // ==========================================
    // 7. AUDIO PLAYER UTILITY
    // ==========================================
    public static class AudioPlayer {
        public static void playSound(String filePath) {
            new Thread(() -> {
                try {
                    File soundFile = new File(filePath);
                    if (soundFile.exists()) {
                        AudioInputStream audioIn = AudioSystem.getAudioInputStream(soundFile);
                        Clip clip = AudioSystem.getClip();
                        clip.open(audioIn);
                        clip.start();
                    } else {
                        // Soft log if audio file is not provided yet
                        System.out.println("Audio clip missing: " + filePath);
                    }
                } catch (Exception e) {
                    System.err.println("Audio error: " + e.getMessage());
                }
            }).start();
        }
    }

    // ==========================================
    // 8. SPRITE LOADER & FALLBACK ENGINE
    // ==========================================
    // ==========================================
    // 8. SPRITE LOADER (WITH ANIMATED GIF SUPPORT)
    // ==========================================
    public static class SpriteLoader {
        private static final String IMAGE_DIR = "images/";

        public static ImageIcon getSprite(String filename, int width, int height, String fallbackText, Color color) {
            File file = new File(IMAGE_DIR + filename);

            if (file.exists()) {
                try {
                    // IF IT IS A GIF: Load directly with ImageIcon to preserve animation!
                    if (filename.toLowerCase().endsWith(".gif")) {
                        return new ImageIcon(file.getAbsolutePath());
                    }

                    // STANDARD PNG/JPG: Read and scale normally
                    BufferedImage originalImage = ImageIO.read(file);
                    Image scaledImage = originalImage.getScaledInstance(width, height, Image.SCALE_SMOOTH);
                    return new ImageIcon(scaledImage);
                } catch (IOException e) {
                    System.err.println("Error loading image: " + filename);
                }
            }

            return new ImageIcon(createFallbackImage(width, height, fallbackText, color));
        }

        private static BufferedImage createFallbackImage(int width, int height, String text, Color accentColor) {
            BufferedImage img = new BufferedImage(width, height, BufferedImage.TYPE_INT_ARGB);
            Graphics2D g2 = img.createGraphics();
            g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);

            g2.setColor(new Color(30, 32, 40));
            g2.fillRect(0, 0, width, height);

            g2.setColor(accentColor);
            g2.setStroke(new BasicStroke(3));
            g2.drawRect(2, 2, width - 5, height - 5);

            g2.setColor(Color.WHITE);
            g2.setFont(new Font("SansSerif", Font.BOLD, Math.max(10, width / 6)));
            FontMetrics fm = g2.getFontMetrics();
            int x = (width - fm.stringWidth(text)) / 2;
            int y = (height - fm.getHeight()) / 2 + fm.getAscent();

            g2.drawString(text, Math.max(5, x), y);
            g2.dispose();

            return img;
        }
    }

