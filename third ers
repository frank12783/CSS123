    // ==========================================
    // 3. GACHA LOGIC & PROBABILITY SYSTEM
    // ==========================================
    private void executeGachaPull() {
        double cost = getCurrentGachaCost();
        if (balance < cost) {
            JOptionPane.showMessageDialog(this, String.format("Insufficient Credits! Need $%.2f", cost), "Gacha Error", JOptionPane.WARNING_MESSAGE);
            return;
        }

        balance -= cost;
        pityCounter++;
        totalPulls++;

        Gun pulledGun;
        double roll = random.nextDouble(); // Range [0.0, 1.0)

        // Drop Percentages:
        // 6-Star Legend Rare: 0.01% (0.0001)
        // 5-Star SSR: 2.00% (0.0200)
        // 4-Star SR: 13.00% (0.1300)
        // 3-Star R: 84.99% (0.8499)

        if (pityCounter >= HARD_PITY) {
            // Hard Pity Yields a 5-Star or 6-Star
            pulledGun = (roll < 0.05) ? getRandomGunByRarity(6) : getRandomGunByRarity(5);
            pityCounter = 0;
        } else if (roll < 0.0001) { // 0.01% Legend Rare
            pulledGun = getRandomGunByRarity(6);
            pityCounter = 0;
        } else if (roll < 0.0201) { // 2.00% 5-Star
            pulledGun = getRandomGunByRarity(5);
            pityCounter = 0;
        } else if (roll < 0.1501) { // 13.00% 4-Star
            pulledGun = getRandomGunByRarity(4);
        } else { // 84.99% 3-Star
            pulledGun = getRandomGunByRarity(3);
        }

        // Play SSR/Legend sound if pulled 5★ or 6★
        if (pulledGun.rarity >= 5) {
            /* AUDIO HOOK: SSR / Legend Pull Sound */
            AudioPlayer.playSound("sounds/ssr_pull.wav");
        } else {
            AudioPlayer.playSound("sounds/pull.wav");
        }

        processAcquiredGun(pulledGun);
        updateHeaderDisplays();
        updateGachaUI(pulledGun);
    }

    private Gun getRandomGunByRarity(int rarity) {
        List<Gun> matching = new ArrayList<>();
        for (Gun g : gachaPool) {
            if (g.rarity == rarity) matching.add(g);
        }
        if (matching.isEmpty()) return gachaPool.get(0);
        Gun template = matching.get(random.nextInt(matching.size()));
        return new Gun(template.id, template.name, template.rarity, template.baseMps, template.spriteFileName);
    }

    private void processAcquiredGun(Gun newGun) {
        Gun existing = findOwnedGun(newGun.id);

        if (existing != null) {
            existing.duplicates++;
        } else {
            boolean equipped = false;
            for (int i = 0; i < equippedGuns.length; i++) {
                if (equippedGuns[i] == null) {
                    equippedGuns[i] = newGun;
                    equipped = true;
                    break;
                }
            }
            if (!equipped) {
                inventory.add(newGun);
            }
        }

        refreshEquippedGrid();
        refreshInventoryUI();
    }

    private Gun findOwnedGun(String id) {
        for (Gun g : equippedGuns) {
            if (g != null && g.id.equals(id)) return g;
        }
        for (Gun g : inventory) {
            if (g.id.equals(id)) return g;
        }
        return null;
    }

    private double calculateTotalMPS() {
        double total = 0.0;
        for (Gun g : equippedGuns) {
            if (g != null) {
                total += g.getEffectiveMps();
            }
        }
        return total;
    }

