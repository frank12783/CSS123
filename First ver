import javax.swing.*;
import javax.swing.border.*;
import java.awt.*;
import java.awt.event.*;
import java.awt.image.BufferedImage;
import java.io.File;
import java.io.IOException;
import javax.imageio.ImageIO;
import java.util.ArrayList;
import java.util.List;
import java.util.Random;

public class GFL2ClickerApp extends JFrame {

    // --- GAME ENGINE STATE ---
    private double balance = 100.0;
    private double moneyPerClick = 1.0;
    private int pityCounter = 0;
    private final int HARD_PITY = 80;
    private final double GACHA_COST = 50.0;

    private final Gun[] equippedGuns = new Gun[10];
    private final List<Gun> inventory = new ArrayList<>();
    private final List<Gun> gachaPool = new ArrayList<>();

    // --- UI COMPONENTS ---
    private JLabel balanceLabel;
    private JLabel mpsLabel;
    private JLabel pityLabel;
    private JLabel pullResultLabel;
    private JLabel pullResultIconLabel;
    private JPanel equippedGridPanel;
    private JPanel inventoryPanel;
    private JProgressBar pityProgressBar;

    private final Random random = new Random();

    public GFL2ClickerApp() {
        setTitle("GFL2 Tactical Clicker & Gacha");
        setSize(1000, 700);
        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        setLocationRelativeTo(null);
        getContentPane().setBackground(new Color(24, 26, 31));

        initGachaPool();
        initUI();
        startGameLoop();
    }

    // ==========================================
    // 1. DATA MODELS & POOL INIT
    // ==========================================
    public static class Gun {
        String id;
        String name;
        int rarity; // 3, 4, or 5
        double baseMps;
        int duplicates;
        String spriteFileName;

        public Gun(String id, String name, int rarity, double baseMps, String spriteFileName) {
            this.id = id;
            this.name = name;
            this.rarity = rarity;
            this.baseMps = baseMps;
            this.duplicates = 0;
            this.spriteFileName = spriteFileName;
        }

        public double getEffectiveMps() {
            return baseMps * (1.0 + (0.25 * duplicates));
        }

        public Color getRarityColor() {
            switch (rarity) {
                case 5: return new Color(255, 183, 3); // Gold
                case 4: return new Color(157, 78, 221); // Purple
                default: return new Color(72, 149, 239); // Blue
            }
        }
    }

    private void initGachaPool() {
        // 5-Star Guns
        gachaPool.add(new Gun("wa2000", "WA2000", 5, 25.0, "wa2000.png"));
        gachaPool.add(new Gun("hk416", "HK416", 5, 30.0, "hk416.png"));
        gachaPool.add(new Gun("vector", "Vector", 5, 22.0, "vector.png"));

        // 4-Star Guns
        gachaPool.add(new Gun("ump45", "UMP45", 4, 8.0, "ump45.png"));
        gachaPool.add(new Gun("m4a1", "M4A1", 4, 10.0, "m4a1.png"));
        gachaPool.add(new Gun("kar98k", "Kar98k", 4, 9.0, "kar98k.png"));

        // 3-Star Guns
        gachaPool.add(new Gun("skorpion", "Skorpion", 3, 2.0, "skorpion.png"));
        gachaPool.add(new Gun("mp5", "MP5", 3, 2.5, "mp5.png"));
        gachaPool.add(new Gun("p90", "P90", 3, 3.0, "p90.png"));
    }

    // ==========================================
    // 2. UI LAYOUT BUILDER
    // ==========================================
    private void initUI() {
        setLayout(new BorderLayout());

        // Top Status Header
        JPanel topHeader = new JPanel(new GridLayout(1, 2, 10, 0));
        topHeader.setBackground(new Color(15, 17, 21));
        topHeader.setBorder(new EmptyBorder(15, 25, 15, 25));

        balanceLabel = new JLabel("Credits: $100.00", SwingConstants.LEFT);
        balanceLabel.setFont(new Font("SansSerif", Font.BOLD, 22));
        balanceLabel.setForeground(new Color(255, 183, 3));

        mpsLabel = new JLabel("MPS: $0.00 / sec", SwingConstants.RIGHT);
        mpsLabel.setFont(new Font("SansSerif", Font.BOLD, 18));
        mpsLabel.setForeground(new Color(0, 180, 216));

        topHeader.add(balanceLabel);
        topHeader.add(mpsLabel);
        add(topHeader, BorderLayout.NORTH);

        // Center Navigation Tabs
        JTabbedPane tabbedPane = new JTabbedPane();
        tabbedPane.setBackground(new Color(24, 26, 31));
        tabbedPane.setForeground(Color.WHITE);
        tabbedPane.setFont(new Font("SansSerif", Font.BOLD, 14));

        tabbedPane.addTab("Terminal (Clicker)", createClickerPanel());
        tabbedPane.addTab("Supply Drop (Gacha)", createGachaPanel());
        tabbedPane.addTab("Armory (Loadout)", createArmoryPanel());

        add(tabbedPane, BorderLayout.CENTER);
    }

    // --- TAB 1: CLICKER TERMINAL ---
    private JPanel createClickerPanel() {
        JPanel panel = new JPanel(new GridBagLayout());
        panel.setBackground(new Color(24, 26, 31));

        JButton clickButton = new JButton("TAP TO MINT CREDITS");
        clickButton.setPreferredSize(new Dimension(300, 200));
        clickButton.setFont(new Font("SansSerif", Font.BOLD, 20));
        clickButton.setForeground(Color.WHITE);
        clickButton.setBackground(new Color(43, 45, 66));
        clickButton.setFocusPainted(false);
        clickButton.setBorder(BorderFactory.createLineBorder(new Color(0, 180, 216), 3));

        // Attach Sprite/Icon to click button
        ImageIcon terminalIcon = SpriteLoader.getSprite("terminal.png", 80, 80, "TAP", new Color(43, 45, 66));
        clickButton.setIcon(terminalIcon);
        clickButton.setVerticalTextPosition(SwingConstants.BOTTOM);
        clickButton.setHorizontalTextPosition(SwingConstants.CENTER);

        clickButton.addActionListener(e -> {
            balance += moneyPerClick;
            updateHeaderDisplays();
        });

        panel.add(clickButton);
        return panel;
    }

    // --- TAB 2: GACHA BANNER ---
    private JPanel createGachaPanel() {
        JPanel panel = new JPanel(new BorderLayout(20, 20));
        panel.setBackground(new Color(24, 26, 31));
        panel.setBorder(new EmptyBorder(20, 30, 20, 30));

        // Banner Image Header
        JLabel bannerLabel = new JLabel();
        bannerLabel.setHorizontalAlignment(SwingConstants.CENTER);
        bannerLabel.setIcon(SpriteLoader.getSprite("banner.png", 600, 150, "GFL2 TACTICAL SUPPLY DROP BANNER", new Color(35, 38, 47)));
        panel.add(bannerLabel, BorderLayout.NORTH);

        // Center Drop Display Area
        JPanel centerDisplay = new JPanel(new BorderLayout(10, 10));
        centerDisplay.setOpaque(false);

        pullResultIconLabel = new JLabel();
        pullResultIconLabel.setHorizontalAlignment(SwingConstants.CENTER);
        pullResultIconLabel.setIcon(SpriteLoader.getSprite("unknown.png", 120, 120, "?", Color.DARK_GRAY));

        pullResultLabel = new JLabel("Press Pull to spend $50.00 Credits", SwingConstants.CENTER);
        pullResultLabel.setFont(new Font("SansSerif", Font.BOLD, 16));
        pullResultLabel.setForeground(Color.WHITE);

        centerDisplay.add(pullResultIconLabel, BorderLayout.CENTER);
        centerDisplay.add(pullResultLabel, BorderLayout.SOUTH);
        panel.add(centerDisplay, BorderLayout.CENTER);

        // Bottom Controls: Pull Button & Pity Tracker
        JPanel bottomControls = new JPanel(new GridLayout(2, 1, 10, 10));
        bottomControls.setOpaque(false);

        JButton pullButton = new JButton("PULL 1x ($50.00)");
        pullButton.setFont(new Font("SansSerif", Font.BOLD, 18));
        pullButton.setBackground(new Color(255, 183, 3));
        pullButton.setForeground(Color.BLACK);
        pullButton.setFocusPainted(false);
        pullButton.addActionListener(e -> executeGachaPull());

        JPanel pityPanel = new JPanel(new BorderLayout(10, 0));
        pityPanel.setOpaque(false);
        pityLabel = new JLabel("Pity Progress (0 / 80)", SwingConstants.LEFT);
        pityLabel.setForeground(Color.LIGHT_GRAY);

        pityProgressBar = new JProgressBar(0, HARD_PITY);
        pityProgressBar.setValue(0);
        pityProgressBar.setForeground(new Color(255, 183, 3));

        pityPanel.add(pityLabel, BorderLayout.WEST);
        pityPanel.add(pityProgressBar, BorderLayout.CENTER);

        bottomControls.add(pullButton);
        bottomControls.add(pityPanel);

        panel.add(bottomControls, BorderLayout.SOUTH);
        return panel;
    }

    // --- TAB 3: ARMORY & LOADOUT ---
    private JPanel createArmoryPanel() {
        JPanel mainPanel = new JPanel(new GridLayout(2, 1, 10, 10));
        mainPanel.setBackground(new Color(24, 26, 31));
        mainPanel.setBorder(new EmptyBorder(15, 15, 15, 15));

        // Top Half: 10 Equipped Gun Slots
        JPanel equippedContainer = new JPanel(new BorderLayout(5, 5));
        equippedContainer.setOpaque(false);
        TitledBorder border = BorderFactory.createTitledBorder(
                BorderFactory.createLineBorder(new Color(0, 180, 216)), "Equipped Loadout (Max 10 Guns)");
        border.setTitleColor(Color.WHITE);
        equippedContainer.setBorder(border);

        equippedGridPanel = new JPanel(new GridLayout(2, 5, 10, 10));
        equippedGridPanel.setOpaque(false);
        refreshEquippedGrid();

        equippedContainer.add(equippedGridPanel, BorderLayout.CENTER);

        // Bottom Half: Unequipped Inventory
        JPanel inventoryContainer = new JPanel(new BorderLayout(5, 5));
        inventoryContainer.setOpaque(false);
        TitledBorder invBorder = BorderFactory.createTitledBorder(
                BorderFactory.createLineBorder(Color.GRAY), "Armory Reserves (Inventory)");
        invBorder.setTitleColor(Color.WHITE);
        inventoryContainer.setBorder(invBorder);

        inventoryPanel = new JPanel(new FlowLayout(FlowLayout.LEFT, 10, 10));
        inventoryPanel.setBackground(new Color(35, 38, 47));

        JScrollPane scrollPane = new JScrollPane(inventoryPanel);
        scrollPane.setHorizontalScrollBarPolicy(ScrollPaneConstants.HORIZONTAL_SCROLLBAR_ALWAYS);
        scrollPane.setVerticalScrollBarPolicy(ScrollPaneConstants.VERTICAL_SCROLLBAR_NEVER);
        scrollPane.getViewport().setBackground(new Color(35, 38, 47));

        inventoryContainer.add(scrollPane, BorderLayout.CENTER);

        mainPanel.add(equippedContainer);
        mainPanel.add(inventoryContainer);

        return mainPanel;
    }

    // ==========================================
    // 3. GACHA LOGIC & EQUIP SYSTEM
    // ==========================================
    private void executeGachaPull() {
        if (balance < GACHA_COST) {
            JOptionPane.showMessageDialog(this, "Insufficient Credits! Tap the terminal to earn more.", "Gacha Error", JOptionPane.WARNING_MESSAGE);
            return;
        }

        balance -= GACHA_COST;
        pityCounter++;

        Gun pulledGun;
        double roll = random.nextDouble();

        // Check Hard Pity or 2% 5-Star Rate
        if (pityCounter >= HARD_PITY || roll < 0.02) {
            pulledGun = getRandomGunByRarity(5);
            pityCounter = 0; // Reset Pity
        } else if (roll < 0.15) { // 13% 4-Star Rate
            pulledGun = getRandomGunByRarity(4);
        } else { // 85% 3-Star Rate
            pulledGun = getRandomGunByRarity(3);
        }

        processAcquiredGun(pulledGun);
        updateHeaderDisplays();
        updateGachaUI(pulledGun);
    }

    private Gun getRandomGunByRarity(int rarity) {
        List<Gun> matching = new ArrayList<>();
        for (Gun g : gachaPool) {
            if (g.rarity == rarity) matching.add(g);
        }
        Gun template = matching.get(random.nextInt(matching.size()));
        return new Gun(template.id, template.name, template.rarity, template.baseMps, template.spriteFileName);
    }

    private void processAcquiredGun(Gun newGun) {
        // Check if already equipped or in inventory
        Gun existing = findOwnedGun(newGun.id);

        if (existing != null) {
            existing.duplicates++;
        } else {
            // Auto-equip if slot is free
            boolean equipped = false;
            for (int i = 0; i < equippedGuns.length; i++) {
                if (equippedGuns[i] == null) {
                    equippedGuns[i] = newGun;
                    equipped = true;
                    break;
                }
            }
            if (!equipped) {
                inventory.add(newGun);
            }
        }

        refreshEquippedGrid();
        refreshInventoryUI();
    }

    private Gun findOwnedGun(String id) {
        for (Gun g : equippedGuns) {
            if (g != null && g.id.equals(id)) return g;
        }
        for (Gun g : inventory) {
            if (g.id.equals(id)) return g;
        }
        return null;
    }

    private double calculateTotalMPS() {
        double total = 0.0;
        for (Gun g : equippedGuns) {
            if (g != null) {
                total += g.getEffectiveMps();
            }
        }
        return total;
    }

    // ==========================================
    // 4. UI REFRESH HELPERS
    // ==========================================
    private void updateHeaderDisplays() {
        balanceLabel.setText(String.format("Credits: $%.2f", balance));
        mpsLabel.setText(String.format("MPS: $%.2f / sec", calculateTotalMPS()));
    }

    private void updateGachaUI(Gun pulled) {
        pullResultLabel.setText(String.format("PULLED: [%d★] %s (+%.1f MPS)", pulled.rarity, pulled.name, pulled.getEffectiveMps()));
        pullResultLabel.setForeground(pulled.getRarityColor());

        ImageIcon icon = SpriteLoader.getSprite(pulled.spriteFileName, 120, 120, pulled.name, pulled.getRarityColor());
        pullResultIconLabel.setIcon(icon);

        pityLabel.setText(String.format("Pity Progress (%d / %d)", pityCounter, HARD_PITY));
        pityProgressBar.setValue(pityCounter);
    }

    private void refreshEquippedGrid() {
        equippedGridPanel.removeAll();
        for (int i = 0; i < 10; i++) {
            Gun gun = equippedGuns[i];
            JPanel slot = new JPanel(new BorderLayout());
            slot.setBackground(new Color(43, 45, 66));

            if (gun != null) {
                slot.setBorder(BorderFactory.createLineBorder(gun.getRarityColor(), 2));

                JLabel nameLbl = new JLabel(gun.name, SwingConstants.CENTER);
                nameLbl.setFont(new Font("SansSerif", Font.BOLD, 12));
                nameLbl.setForeground(gun.getRarityColor());

                JLabel iconLbl = new JLabel(SpriteLoader.getSprite(gun.spriteFileName, 60, 60, gun.name, gun.getRarityColor()));
                iconLbl.setHorizontalAlignment(SwingConstants.CENTER);

                JLabel mpsLbl = new JLabel(String.format("+%.1f/s (Ref %d)", gun.getEffectiveMps(), gun.duplicates), SwingConstants.CENTER);
                mpsLbl.setFont(new Font("SansSerif", Font.PLAIN, 10));
                mpsLbl.setForeground(Color.LIGHT_GRAY);

                slot.add(nameLbl, BorderLayout.NORTH);
                slot.add(iconLbl, BorderLayout.CENTER);
                slot.add(mpsLbl, BorderLayout.SOUTH);
            } else {
                slot.setBorder(BorderFactory.createDashedBorder(Color.GRAY));
                JLabel emptyLbl = new JLabel("EMPTY SLOT", SwingConstants.CENTER);
                emptyLbl.setForeground(Color.DARK_GRAY);
                slot.add(emptyLbl, BorderLayout.CENTER);
            }
            equippedGridPanel.add(slot);
        }
        equippedGridPanel.revalidate();
        equippedGridPanel.repaint();
    }

    private void refreshInventoryUI() {
        inventoryPanel.removeAll();
        for (Gun gun : inventory) {
            JPanel card = new JPanel(new BorderLayout(5, 5));
            card.setPreferredSize(new Dimension(90, 110));
            card.setBackground(new Color(24, 26, 31));
            card.setBorder(BorderFactory.createLineBorder(gun.getRarityColor(), 1));

            JLabel nameLbl = new JLabel(gun.name, SwingConstants.CENTER);
            nameLbl.setForeground(Color.WHITE);
            nameLbl.setFont(new Font("SansSerif", Font.BOLD, 11));

            JLabel iconLbl = new JLabel(SpriteLoader.getSprite(gun.spriteFileName, 50, 50, gun.name, gun.getRarityColor()));
            iconLbl.setHorizontalAlignment(SwingConstants.CENTER);

            JLabel dupeLbl = new JLabel("Dupes: " + gun.duplicates, SwingConstants.CENTER);
            dupeLbl.setFont(new Font("SansSerif", Font.PLAIN, 10));
            dupeLbl.setForeground(Color.LIGHT_GRAY);

            card.add(nameLbl, BorderLayout.NORTH);
            card.add(iconLbl, BorderLayout.CENTER);
            card.add(dupeLbl, BorderLayout.SOUTH);

            inventoryPanel.add(card);
        }
        inventoryPanel.revalidate();
        inventoryPanel.repaint();
    }

    // ==========================================
    // 5. GAME LOOP TIMER
    // ==========================================
    private void startGameLoop() {
        // Runs every 100 milliseconds (10 times per second)
        Timer timer = new Timer(100, e -> {
            double mps = calculateTotalMPS();
            balance += (mps / 10.0); // Add 1/10th of MPS every 100ms
            updateHeaderDisplays();
        });
        timer.start();
    }

    // ==========================================
    // 6. SPRITE LOADER & FALLBACK ENGINE
    // ==========================================
    public static class SpriteLoader {
        private static final String IMAGE_DIR = "images/";

        public static ImageIcon getSprite(String filename, int width, int height, String fallbackText, Color color) {
            File file = new File(IMAGE_DIR + filename);

            if (file.exists()) {
                try {
                    BufferedImage originalImage = ImageIO.read(file);
                    Image scaledImage = originalImage.getScaledInstance(width, height, Image.SCALE_SMOOTH);
                    return new ImageIcon(scaledImage);
                } catch (IOException e) {
                    System.err.println("Error loading image: " + filename);
                }
            }

            // Fallback: Generate a procedural styled icon if PNG file is missing
            return new ImageIcon(createFallbackImage(width, height, fallbackText, color));
        }

        private static BufferedImage createFallbackImage(int width, int height, String text, Color accentColor) {
            BufferedImage img = new BufferedImage(width, height, BufferedImage.TYPE_INT_ARGB);
            Graphics2D g2 = img.createGraphics();

            g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);

            // Fill background
            g2.setColor(new Color(30, 32, 40));
            g2.fillRect(0, 0, width, height);

            // Inner border accent
            g2.setColor(accentColor);
            g2.setStroke(new BasicStroke(3));
            g2.drawRect(2, 2, width - 5, height - 5);

            // Draw text abbreviation
            g2.setColor(Color.WHITE);
            g2.setFont(new Font("SansSerif", Font.BOLD, Math.max(10, width / 6)));
            FontMetrics fm = g2.getFontMetrics();
            int x = (width - fm.stringWidth(text)) / 2;
            int y = (height - fm.getHeight()) / 2 + fm.getAscent();

            g2.drawString(text, Math.max(5, x), y);
            g2.dispose();

            return img;
        }
    }

    public static void main(String[] args) {
        SwingUtilities.invokeLater(() -> new GFL2ClickerApp().setVisible(true));
    }
}
