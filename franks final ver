    public static class Gun {
        String id;
        String name;
        int rarity; // 3, 4, 5, or 6 (Legend Rare)
        double baseMps;
        int duplicates;
        String spriteFileName;

        public Gun(String id, String name, int rarity, double baseMps, String spriteFileName) {
            this.id = id;
            this.name = name;
            this.rarity = rarity;
            this.baseMps = baseMps;
            this.duplicates = 0;
            this.spriteFileName = spriteFileName;
        }

        public double getEffectiveMps() {
            return baseMps * (1.0 + (0.25 * duplicates));
        }

        public Color getRarityColor() {
            switch (rarity) {
                case 6: return new Color(255, 70, 0);   // LEGEND RARE (Crimson Orange)
                case 5: return new Color(255, 183, 3);  // SSR (Gold)
                case 4: return new Color(157, 78, 221); // SR (Purple)
                default: return new Color(72, 149, 239); // R (Blue)
            }
        }
    }

